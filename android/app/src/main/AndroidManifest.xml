<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <uses-feature android:glEsVersion="0x00020000" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Games live in the gmrunner folder on internal storage, copied there by the player. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:label="gmRunner"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="true"
        android:appCategory="game"
        android:isGame="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:hardwareAccelerated="true">
        <!-- The game list (Compose, Material 3 Expressive). -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- A running game: SDL's activity in a process of its own, ended with the game, so
             every game starts from a clean slate. -->
        <activity
            android:name=".GameActivity"
            android:process=":game"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:launchMode="singleTask"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true" />
        <!-- The in-game menu (Compose) over a running game, in the game's process. -->
        <activity
            android:name=".MenuActivity"
            android:process=":game"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:screenOrientation="behind"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation" />
    </application>
</manifest>
