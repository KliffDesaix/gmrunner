#---------------------------------------------------------------------------------
# Nintendo Switch homebrew build (devkitPro devkitA64 + libnx + SDL2 + Mesa).
#
#   dkp-pacman -S switch-dev switch-sdl2 switch-mesa switch-libdrm_nouveau
#   dkp-pacman -S switch-ffmpeg   (optional: video playback)
#   make -f Makefile.switch
#
# Produces gmrunner.nro. To bundle a game into the .nro, copy its files to
# switch/romfs/game/ before building; otherwise the runner loads games from
# sdmc:/switch/gmrunner/games/<name>/ (see docs/SWITCH.md).
#---------------------------------------------------------------------------------
.SUFFIXES:

ifeq ($(strip $(DEVKITPRO)),)
$(error "Please set DEVKITPRO in your environment. export DEVKITPRO=<path to>/devkitpro")
endif

TOPDIR ?= $(CURDIR)
include $(DEVKITPRO)/libnx/switch_rules

TARGET      := gmrunner
BUILD       := build-switch
SOURCES     := src/data src/vm src/render src/runtime src/runtime/lib src/platform/sdl src/util
DATA        :=
INCLUDES    := src third_party
ROMFS       := $(if $(wildcard switch/romfs),switch/romfs,)
APP_TITLE   := gmRunner
APP_AUTHOR  := gmrunner
APP_VERSION := $(strip $(file < $(TOPDIR)/VERSION))
ICON        := switch/icon.jpg

#---------------------------------------------------------------------------------
ARCH     := -march=armv8-a+crc+crypto -mtune=cortex-a57 -mtp=soft -fPIE

CFLAGS   := -g -Wall -O2 -ffunction-sections $(ARCH) $(DEFINES)
CFLAGS   += $(INCLUDE) -D__SWITCH__ $(shell $(PORTLIBS)/bin/sdl2-config --cflags)
# The built-in fonts (src/util/BuiltinFonts.cpp) are read from here at compile time.
CFLAGS   += -DGMR_VERSION=\"$(APP_VERSION)\"
# Local modules kept outside the repository (private/<module>/), unless GMR_PRIVATE=0
ifneq ($(GMR_PRIVATE),0)
ifneq ($(wildcard $(TOPDIR)/private/*/*.cpp),)
SOURCES  += $(patsubst $(TOPDIR)/%,%,$(wildcard $(TOPDIR)/private/*))
CFLAGS   += -DGMR_SKELETON_MODULE
endif
endif
CFLAGS   += -DGMR_FONT_DIR=\"$(TOPDIR)/third_party/liberation-fonts\"

# Video playback (video_open) when FFmpeg is installed: dkp-pacman -S switch-ffmpeg
FFMPEG_PC   := $(PORTLIBS)/bin/aarch64-none-elf-pkg-config
FFMPEG_MODS := libavformat libavcodec libswscale libswresample libavutil
ifneq ($(wildcard $(PORTLIBS)/lib/libavcodec.a),)
CFLAGS   += -DGMR_FFMPEG $(shell $(FFMPEG_PC) --cflags $(FFMPEG_MODS))
FFMPEG_LIBS := $(shell $(FFMPEG_PC) --static --libs $(FFMPEG_MODS))
endif

# bzip2 texture pages with randomised blocks need libbz2: dkp-pacman -S switch-bzip2
ifneq ($(wildcard $(PORTLIBS)/lib/libbz2.a),)
CFLAGS   += -DGMR_LIBBZ2
BZ2_LIBS := -lbz2
endif

# The game list in the console's own look (Borealis), when tools/switch/build-launcher.sh has
# built it: linked in, its resources packed as the NRO's romfs. Without it the runner falls back
# to a text-console list.
LAUNCHER := build-switch-launcher
ifneq ($(wildcard $(TOPDIR)/$(LAUNCHER)/libgmrlauncher.a),)
CFLAGS += -DGMR_SWITCH_LAUNCHER
LAUNCHER_LIBS := -L$(TOPDIR)/$(LAUNCHER) -L$(TOPDIR)/$(LAUNCHER)/borealis -L$(TOPDIR)/$(LAUNCHER)/borealis/lib/extern/fmt \
                 -L$(TOPDIR)/$(LAUNCHER)/borealis/lib/extern/yoga/yoga -lgmrlauncher -lborealis -ltinyxml2 -lfmt -lyogacore
LAUNCHER_DEPS := $(TOPDIR)/$(LAUNCHER)/libgmrlauncher.a
ifeq ($(ROMFS),)
ROMFS := $(LAUNCHER)/romfs
endif
endif

# The VM relies on C++ exceptions and RTTI, so the template's -fno-exceptions is left out.
CXXFLAGS := $(CFLAGS) -std=gnu++17 -Wno-unused-parameter -Wno-unused-function -Wno-maybe-uninitialized

ASFLAGS  := -g $(ARCH)
LDFLAGS   = -specs=$(DEVKITPRO)/libnx/switch.specs -g $(ARCH) -Wl,-Map,$(notdir $*.map)

LIBS     := $(LAUNCHER_LIBS) $(FFMPEG_LIBS) $(BZ2_LIBS) $(shell $(PORTLIBS)/bin/sdl2-config --libs) -lEGL -lglapi -ldrm_nouveau -lnx

LIBDIRS  := $(PORTLIBS) $(LIBNX)

#---------------------------------------------------------------------------------
ifneq ($(BUILD),$(notdir $(CURDIR)))
#---------------------------------------------------------------------------------

export OUTPUT   := $(CURDIR)/$(TARGET)
export TOPDIR   := $(CURDIR)
export VPATH    := $(foreach dir,$(SOURCES),$(CURDIR)/$(dir)) $(foreach dir,$(DATA),$(CURDIR)/$(dir))
export DEPSDIR  := $(CURDIR)/$(BUILD)

CFILES   := $(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.c)))
CPPFILES := $(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.cpp)))
SFILES   := $(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.s)))
BINFILES := $(foreach dir,$(DATA),$(notdir $(wildcard $(dir)/*.*)))

export LD := $(CXX)

export OFILES_BIN := $(addsuffix .o,$(BINFILES))
export OFILES_SRC := $(CPPFILES:.cpp=.o) $(CFILES:.c=.o) $(SFILES:.s=.o)
export OFILES     := $(OFILES_BIN) $(OFILES_SRC)
export HFILES_BIN := $(addsuffix .h,$(subst .,_,$(BINFILES)))

export INCLUDE  := $(foreach dir,$(INCLUDES),-I$(CURDIR)/$(dir)) \
                   $(foreach dir,$(LIBDIRS),-I$(dir)/include) \
                   -I$(CURDIR)/$(BUILD)
export LIBPATHS := $(foreach dir,$(LIBDIRS),-L$(dir)/lib)

ifneq ($(wildcard $(ICON)),)
	export APP_ICON := $(TOPDIR)/$(ICON)
else
	export APP_ICON := $(LIBNX)/default_icon.jpg
endif

export NROFLAGS += --icon=$(APP_ICON) --nacp=$(CURDIR)/$(TARGET).nacp
ifneq ($(ROMFS),)
	export NROFLAGS += --romfsdir=$(CURDIR)/$(ROMFS)
endif

.PHONY: $(BUILD) clean all

all: $(BUILD)

$(BUILD):
	@[ -d $@ ] || mkdir -p $@
	@$(MAKE) --no-print-directory -C $(BUILD) -f $(CURDIR)/Makefile.switch

clean:
	@echo clean ...
	@rm -fr $(BUILD) $(TARGET).nro $(TARGET).nacp $(TARGET).elf

#---------------------------------------------------------------------------------
else
#---------------------------------------------------------------------------------
.PHONY: all

DEPENDS := $(OFILES:.o=.d)

all: $(OUTPUT).nro

$(OUTPUT).nro: $(OUTPUT).elf $(OUTPUT).nacp

$(OUTPUT).elf: $(OFILES) $(LAUNCHER_DEPS)

$(OFILES_SRC): $(HFILES_BIN)

-include $(DEPENDS)

#---------------------------------------------------------------------------------
endif
#---------------------------------------------------------------------------------
